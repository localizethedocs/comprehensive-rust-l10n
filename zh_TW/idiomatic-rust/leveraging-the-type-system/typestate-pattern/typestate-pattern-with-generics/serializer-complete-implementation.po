#: src/idiomatic/leveraging-the-type-system/typestate-pattern/typestate-generics/complete.md:6
msgid "Serializer: complete implementation"
msgstr ""

#: src/idiomatic/leveraging-the-type-system/typestate-pattern/typestate-generics/complete.md:8
msgid "Looking back at our original desired flow:"
msgstr ""

#: src/idiomatic/leveraging-the-type-system/typestate-pattern/typestate-generics/complete.md:24
msgid "We can now see this reflected directly in the types of our serializer:"
msgstr ""

#: src/idiomatic/leveraging-the-type-system/typestate-pattern/typestate-generics/complete.md:26
msgid ""
"```bob\n"
"                                                     +------+\n"
"                                             finish  |      |\n"
"                          serialize          struct  V      |\n"
"                          struct\n"
"+--------------------+ --------------> +-------------------------+ "
"<---------------+\n"
"| \"Serializer<Root>\" |                 | \"Serializer<Struct<S>>\" "
"|                 |\n"
"+--------------------+ <-------------- +-------------------------+ "
"<-----------+   |\n"
"                         finish "
"struct                                         |   |\n"
"         |                                  |  serialize   "
"|                   |   |\n"
"         |                       +----------+  property    V        "
"serialize  |   |\n"
"         |                       |                                  string "
"or  |   |\n"
"finish   |                       |   +---------------------------+  "
"struct     |   |\n"
"         V                       |   | \"Serializer<Property<S>>\" | "
"------------+   |\n"
"                         finish  |   +---------------------------"
"+                 |\n"
"     +--------+          struct  "
"|                                                 |\n"
"     | String |                  |             serialize   "
"|                       |\n"
"     +--------+                  |             list        "
"V                       |\n"
"                                 |                                    "
"finish       |\n"
"                                 |       +-----------------------+    "
"list         |\n"
"                                 +-----> | \"Serializer<List<S>>\" | "
"----------------+\n"
"                                         +-----------------------+\n"
"                                              serialize\n"
"                                            | list or string  ^\n"
"                                            | or finish list  |\n"
"                                            +-----------------+\n"
"```"
msgstr ""

