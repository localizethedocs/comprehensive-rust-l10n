#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/with-copy-setter.md:6
msgid "`with` as copy-and-set"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/with-copy-setter.md:8
msgid ""
"`with` appears when a value is being copied, but also changed in a specific "
"way."
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/with-copy-setter.md:10
msgid "`with` as in \"like `<value>`, but with something different.\""
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/with-copy-setter.md:13
