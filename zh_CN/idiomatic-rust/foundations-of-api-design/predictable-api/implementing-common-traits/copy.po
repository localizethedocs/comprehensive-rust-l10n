#: src/idiomatic/foundations-api-design/predictable-api/common-traits/copy.md:6
msgid "Copy"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/copy.md:8
msgid "Like `Clone`, but indicates the type is can be bitwise copied."
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/copy.md:10
msgid "Derivable: ✅"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/copy.md:13
msgid "// Copyright 2025 Google LLC\n"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/copy.md:14
