#: src/unsafe-deep-dive/rules-of-the-game/copying-memory/safe.md:6
msgid "Safe Rust"
msgstr ""

#: src/unsafe-deep-dive/rules-of-the-game/copying-memory/safe.md:9
msgid "// Copyright 2026 Google LLC\n"
msgstr ""

#: src/unsafe-deep-dive/rules-of-the-game/copying-memory/safe.md:10
