"The pointer `arr` is non-null, well-aligned and refers to an array of `i32`"
msgstr ""

#: src/unsafe-deep-dive/safety-preconditions/getter.md:29
msgid "`index` is in-bounds"
msgstr ""

#: src/unsafe-deep-dive/safety-preconditions/getter.md:31
msgid "Add safety comments:"
msgstr ""

#: src/unsafe-deep-dive/safety-preconditions/getter.md:36
msgid ""
"/// Return the element at `index` from `arr`\n"
"///\n"
"/// # Safety\n"
"///\n"
"/// - `arr` is non-null, correctly aligned and points to a valid `i32`\n"
"/// - `index` is in-bounds for the array\n"
msgstr ""

#: src/unsafe-deep-dive/safety-preconditions/getter.md:44
msgid "// SAFETY: Caller guarantees that index is inbounds\n"
msgstr ""

