#: src/idiomatic/foundations-api-design/meaningful-doc-comments/anatomy-of-a-doc-comment.md:6
msgid "The Anatomy of a Doc Comment"
msgstr ""

#: src/idiomatic/foundations-api-design/meaningful-doc-comments/anatomy-of-a-doc-comment.md:8
msgid "A brief, one-sentence summary."
msgstr ""

#: src/idiomatic/foundations-api-design/meaningful-doc-comments/anatomy-of-a-doc-comment.md:9
msgid "A more detailed explanation."
msgstr ""

#: src/idiomatic/foundations-api-design/meaningful-doc-comments/anatomy-of-a-doc-comment.md:10
msgid "Special sections: code examples, panics, errors, safety preconditions."
msgstr ""

