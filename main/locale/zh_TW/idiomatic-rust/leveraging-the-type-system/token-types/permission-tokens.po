#: src/idiomatic/leveraging-the-type-system/token-types/permission-tokens.md:6
msgid "Permission Tokens"
msgstr ""

#: src/idiomatic/leveraging-the-type-system/token-types/permission-tokens.md:8
msgid "Token types work well as a proof of checked permission."
msgstr ""

