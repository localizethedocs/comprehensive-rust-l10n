#: src/unsafe-deep-dive/initialization/partial-initialization.md:6
msgid "Partial Initialization"
msgstr ""

#: src/unsafe-deep-dive/initialization/partial-initialization.md:9
msgid "// Copyright 2026 Google LLC\n"
msgstr ""

#: src/unsafe-deep-dive/initialization/partial-initialization.md:10
