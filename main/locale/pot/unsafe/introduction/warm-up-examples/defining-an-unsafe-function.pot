#: src/unsafe-deep-dive/introduction/warm-up/unsafe-fn.md:6
msgid "Defining an unsafe function"
msgstr ""

#: src/unsafe-deep-dive/introduction/warm-up/unsafe-fn.md:9
msgid "// Copyright 2026 Google LLC\n"
msgstr ""

#: src/unsafe-deep-dive/introduction/warm-up/unsafe-fn.md:10
