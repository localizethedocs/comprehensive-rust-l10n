#: src/unsafe-deep-dive/initialization/maybeuninit.md:6
msgid "MaybeUninit<T>"
msgstr ""

#: src/unsafe-deep-dive/initialization/maybeuninit.md:8
msgid "`MaybeUninit<T>` allows Rust to refer to uninitialized memory."
msgstr ""

#: src/unsafe-deep-dive/initialization/maybeuninit.md:11
msgid "// Copyright 2026 Google LLC\n"
msgstr ""

#: src/unsafe-deep-dive/initialization/maybeuninit.md:12
