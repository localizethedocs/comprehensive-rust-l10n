msgstr ""

#: src/idiomatic/leveraging-the-type-system/raii/drop_option.md:33
msgid "\"automatically closing handle for file: {}\""
msgstr ""

#: src/idiomatic/leveraging-the-type-system/raii/drop_option.md:43
msgid "\"closed handle for file: {}\""
msgstr ""

