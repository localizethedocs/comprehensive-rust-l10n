#: src/idiomatic/leveraging-the-type-system/raii/drop_option.md:20
msgid ""
"// We have to go through the `Option` to get the `Handle`\n"
"        // before we can use it.\n"
msgstr ""

#: src/idiomatic/leveraging-the-type-system/raii/drop_option.md:23
msgid "\"write '{data}' to file '{}'\""
msgstr ""

#: src/idiomatic/leveraging-the-type-system/raii/drop_option.md:41
msgid "\"Closing {}\""
msgstr ""

#: src/idiomatic/leveraging-the-type-system/raii/drop_option.md:46
