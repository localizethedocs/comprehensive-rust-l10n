msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/unchecked.md:20
msgid "// Unchecked constructor, you can violate the non-null invariant!\n"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/unchecked.md:25
