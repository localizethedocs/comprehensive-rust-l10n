#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/with-constructor.md:6
msgid "`with` as constructor"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/with-constructor.md:8
msgid ""
"`with` as a constructor sets one value among a type while using default "
"values for the rest."
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/with-constructor.md:11
msgid "`with` as in \"`<Type>` with specific setting.\""
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/with-constructor.md:14
msgid "// Copyright 2025 Google LLC\n"
msgstr ""

