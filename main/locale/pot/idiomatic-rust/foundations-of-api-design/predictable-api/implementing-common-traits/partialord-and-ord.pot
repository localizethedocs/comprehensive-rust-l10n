#: src/idiomatic/foundations-api-design/predictable-api/common-traits/partialord-ord.md:6
msgid "PartialOrd and Ord"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/partialord-ord.md:8
msgid "Partial ordering & Total ordering."
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/partialord-ord.md:10
msgid "Derivable: ✅"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/partialord-ord.md:12
msgid "When to implement: Almost always."
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/partialord-ord.md:15
msgid "// Copyright 2025 Google LLC\n"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/partialord-ord.md:16
