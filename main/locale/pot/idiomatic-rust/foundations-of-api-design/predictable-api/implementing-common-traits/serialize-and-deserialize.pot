#: src/idiomatic/foundations-api-design/predictable-api/common-traits/serde.md:6
msgid "Serialize/Deserialize style traits"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/serde.md:8
msgid "Crates like `serde` can implement serialization automatically."
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/serde.md:10
msgid "Derivable: ✅"
msgstr ""

