#: src/idiomatic/foundations-api-design/predictable-api.md:6
msgid "Predictable API"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api.md:8
msgid ""
"Keep your APIs predictable through naming conventions and implementing "
"common traits."
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api.md:12
msgid "// Copyright 2025 Google LLC\n"
msgstr ""

