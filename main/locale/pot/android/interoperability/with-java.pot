msgid "// Copyright 2022 Google LLC\n"
msgstr ""

#: src/android/interoperability/java.md:19
msgid "// SPDX-License-Identifier: Apache-2.0\n"
msgstr ""

#: src/android/interoperability/java.md:20
msgid "//! Rust <-> Java FFI demo.\n"
msgstr ""

#: src/android/interoperability/java.md:26
msgid ""
"/// HelloWorld::hello method implementation.\n"
"// SAFETY: There is no other global function of this name.\n"
msgstr ""

#: src/android/interoperability/java.md:30
