#: src/idiomatic/leveraging-the-type-system/raii/drop_skipped.md:6
msgid "Drop can be skipped"
msgstr ""

#: src/idiomatic/leveraging-the-type-system/raii/drop_skipped.md:8
msgid "There are cases where destructors will not run."
msgstr ""

#: src/idiomatic/leveraging-the-type-system/raii/drop_skipped.md:11
msgid "// Copyright 2025 Google LLC\n"
msgstr ""

#: src/idiomatic/leveraging-the-type-system/raii/drop_skipped.md:12
