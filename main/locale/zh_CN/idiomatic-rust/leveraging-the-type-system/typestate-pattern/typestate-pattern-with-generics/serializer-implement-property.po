#: src/idiomatic/leveraging-the-type-system/typestate-pattern/typestate-generics/property.md:56
msgid ""
"```bob\n"
"                                                     +------+\n"
"                                             finish  |      |\n"
"                          serialize          struct  V      |\n"
"                          struct\n"
"+--------------------+ --------------> +-------------------------+\n"
"| \"Serializer<Root>\" |                 | \"Serializer<Struct<S>>\" |\n"
"+--------------------+ <-------------- +-------------------------+ "
"<-----------+\n"
"                         finish "
"struct                                         |\n"
"         |                                     serialize   "
"|                   |\n"
"         |                                     property    V        "
"serialize  |\n"
"         |                                                          string "
"or  |\n"
"finish   |                           +---------------------------+  "
"struct     |\n"
"         V                           | \"Serializer<Property<S>>\" | "
"------------+\n"
"                                     +---------------------------+\n"
"     +--------+\n"
"     | String |                                serialize   |\n"
"     +--------+                                list        V\n"
"\n"
"                                         +-----------------------+\n"
"                                         | \"Serializer<List<S>>\" |\n"
"                                         +-----------------------+\n"
"```"
msgstr ""

#: src/idiomatic/leveraging-the-type-system/typestate-pattern/typestate-generics/property.md:82
msgid ""
"A property can be defined as a `String`, `Struct<S>`, or `List<S>`, enabling "
"the representation of nested structures."
msgstr ""

