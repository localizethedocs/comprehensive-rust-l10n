msgid "Clone"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/clone.md:8
msgid "Deep-copy a type or duplicate a smart, shareable pointer."
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/clone.md:10
msgid "Derivable: ✅"
msgstr ""

#: src/idiomatic/foundations-api-design/predictable-api/common-traits/clone.md:12
msgid "When to implement: If duplicating doesn't break invariants."
msgstr ""

